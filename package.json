{
  "name": "tpservicos",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @tpservicos/api",
    "dev:web": "npm run dev --workspace @tpservicos/web",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @tpservicos/api",
    "db:migrate": "npm run db:migrate --workspace @tpservicos/api",
    "db:seed": "npm run db:seed --workspace @tpservicos/api",
    "test": "tsx --test apps/api/test/*.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2"
  }
}
